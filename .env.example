APP_ENV=local
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5500

# Supabase PostgreSQL connection (psycopg3 DSN)
SUPABASE_DATABASE_URL=

# Required for the FastAPI document-library routes; leave empty to keep them locked.
ADMIN_API_KEY=

# Required for /ask and /search when APP_ENV is not "local" (fails closed with 401 if empty).
# Use a different value from ADMIN_API_KEY. Only the Pulse360 server should hold it.
QUERY_API_KEY=

# Collections that /ask and /search may query (comma separated). When empty, only
# COLLECTION below is allowed. Other collection IDs return 403.
PUBLIC_COLLECTIONS=

# Default collection for /search and /ask calls
COLLECTION=faq_documents

# Embeddings. EMBEDDING_PROVIDER is "huggingface" (default) or "openai".
# The pgvector column is fixed at VECTOR_DIMENSIONS, and a collection must be queried with
# the same model that embedded it. Changing provider or model means re-embedding documents.
EMBEDDING_PROVIDER=huggingface
# Hugging Face hosted embeddings (needs Inference Provider credits on the token's account)
HF_TOKEN=
EMBEDDING_URL=
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# OpenAI embeddings (uses OPENAI_API_KEY below; vectors are shortened to VECTOR_DIMENSIONS):
# EMBEDDING_PROVIDER=openai
# EMBEDDING_URL=https://api.openai.com/v1/embeddings
# EMBEDDING_MODEL=text-embedding-3-large   # use a model your OpenAI project can access
EMBEDDING_REVISION=main
VECTOR_DIMENSIONS=384
EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages: "
# Leave blank for most models. Set a prefix if the model requires one for
# passage encoding (e.g. "passage: " for some E5 variants).
EMBEDDING_DOCUMENT_PREFIX=

# Hosted LLM — HuggingFace (dev / sandbox) or OpenAI (production)
#
# Current stage: development and dev-testing — HuggingFace router is used.
# Production deployment will switch to OpenAI; update LLM_BASE_URL,
# LLM_MODEL, and LLM_PROVIDER at that point. No code changes required —
# synthesize() in llm/client.py dispatches on LLM_PROVIDER at call time.
#
# HuggingFace (dev default):
LLM_BASE_URL=https://router.huggingface.co/v1
LLM_MODEL=Qwen/Qwen3-4B-Instruct-2507:nscale
LLM_PROVIDER=huggingface
# Set when LLM_PROVIDER=openai (production):
OPENAI_API_KEY=
#
# OpenAI (production — swap these three values when promoting):
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_PROVIDER=openai

# Tuning
REQUEST_TIMEOUT=30
CONTEXT_K=4
CHUNK_CHARS=1000
CHUNK_OVERLAP=150
