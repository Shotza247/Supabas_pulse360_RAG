APP_ENV=local
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5500

# Supabase PostgreSQL connection (psycopg3 DSN)
SUPABASE_DATABASE_URL=

# Default collection for unauthenticated /search and /ask calls
COLLECTION=faq_documents

# Hugging Face hosted embeddings
HF_TOKEN=
EMBEDDING_URL=
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_REVISION=main
VECTOR_DIMENSIONS=384
EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages: "
# Leave blank for most models. Set a prefix if the model requires one for
# passage encoding (e.g. "passage: " for some E5 variants).
EMBEDDING_DOCUMENT_PREFIX=

# Hosted LLM — HuggingFace (dev / sandbox) or OpenAI (production)
#
# Current stage: development and dev-testing — HuggingFace router is used.
# Production deployment will switch to OpenAI; update LLM_BASE_URL,
# LLM_MODEL, and LLM_PROVIDER at that point. No code changes required —
# synthesize() in llm/client.py dispatches on LLM_PROVIDER at call time.
#
# HuggingFace (dev default):
LLM_BASE_URL=https://router.huggingface.co/v1
LLM_MODEL=Qwen/Qwen3-4B-Instruct-2507:nscale
LLM_PROVIDER=huggingface
#
# OpenAI (production — uncomment and replace values when promoting):
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_PROVIDER=openai
# OPENAI_API_KEY=

# Tuning
REQUEST_TIMEOUT=30
CONTEXT_K=4
CHUNK_CHARS=1000
CHUNK_OVERLAP=150
